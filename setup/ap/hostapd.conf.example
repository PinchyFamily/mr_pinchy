# AP on Alfa AWUS036ACS (RTL8811AU). Isolated network - no internet routing.
interface=wlx00c0cab7c94c
driver=nl80211

ssid=pinchy-ap
country_code=SE
ieee80211d=1

hw_mode=g
channel=6
ieee80211n=1
wmm_enabled=1

auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=CHANGE_ME

macaddr_acl=0
ignore_broadcast_ssid=0
