# Intel RealSense D435i Depth Camera
# Vendor: 8086  Product: 0b3a
# Grants plugdev/uaccess access to the USB device, its video nodes, and the IMU (HID)
SUBSYSTEM=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", GROUP="plugdev", MODE="0660", TAG+="uaccess", SYMLINK+="realsense_d435i"
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", GROUP="video", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", GROUP="plugdev", MODE="0660", TAG+="uaccess"
